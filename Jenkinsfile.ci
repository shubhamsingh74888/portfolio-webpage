// ─────────────────────────────────────────────────────────────────────────────
// Portfolio Website — CI Pipeline
// Stages: Checkout → OWASP → Build → Trivy Scan → ECR Push → GitOps Update → Notify
// ─────────────────────────────────────────────────────────────────────────────

@Library('portfolio-shared-lib') _

pipeline {

    agent any

    environment {
        REGISTRY    = "439328746071.dkr.ecr.ap-south-1.amazonaws.com"
        PROJECT     = "portfolio"
        AWS_REGION  = "ap-south-1"
        GITOPS_REPO = "shubhamsingh74888/portfolio-webpage"
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo "Branch: ${env.BRANCH_NAME} | Build: #${env.BUILD_NUMBER}"
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                owaspScan(project: env.PROJECT)
            }
        }

        stage('Build Images') {
            steps {
                buildImages(
                    registry:    env.REGISTRY,
                    project:     env.PROJECT,
                    buildNumber: env.BUILD_NUMBER.toInteger()
                )
            }
        }

        stage('Trivy Scan') {
            steps {
                scanImages(
                    registry:    env.REGISTRY,
                    project:     env.PROJECT,
                    buildNumber: env.BUILD_NUMBER.toInteger()
                )
            }
        }

        stage('ECR Push') {
            steps {
                pushToECR(
                    registry:    env.REGISTRY,
                    project:     env.PROJECT,
                    region:      env.AWS_REGION,
                    buildNumber: env.BUILD_NUMBER.toInteger()
                )
            }
        }

        stage('GitOps Update') {
            steps {
                updateGitops(
                    registry:    env.REGISTRY,
                    project:     env.PROJECT,
                    gitOpsRepo:  env.GITOPS_REPO,
                    buildNumber: env.BUILD_NUMBER.toInteger()
                )
            }
        }
    }

    post {
        success {
            notifySlackSNS(
                status:      'SUCCESS',
                project:     env.PROJECT,
                buildNumber: env.BUILD_NUMBER.toInteger(),
                buildUrl:    env.BUILD_URL,
                region:      env.AWS_REGION
            )
            sh 'docker rmi $(docker images -q --filter "reference=*portfolio*") 2>/dev/null || true'
        }
        failure {
            notifySlackSNS(
                status:      'FAILURE',
                project:     env.PROJECT,
                buildNumber: env.BUILD_NUMBER.toInteger(),
                buildUrl:    env.BUILD_URL,
                region:      env.AWS_REGION,
                stageName:   env.STAGE_NAME
            )
        }
        always {
            cleanWs()
        }
    }
}
