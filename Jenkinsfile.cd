// ─────────────────────────────────────────────────────────────────────────────
// Portfolio Website — CD Pipeline
// Stages: Smoke Test → Rollback on failure → Notify
// ─────────────────────────────────────────────────────────────────────────────

@Library('portfolio-shared-lib') _

pipeline {

    agent any

    environment {
        PROJECT     = "portfolio"
        AWS_REGION  = "ap-south-1"
        GITOPS_REPO = "shubhamsingh74888/portfolio-webpage"
        APP_URL     = "http://13.234.115.135:31441"
    }

    parameters {
        string(
            name:         'BUILD_TAG',
            defaultValue: '1',
            description:  'Build number from CI pipeline'
        )
    }

    options {
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {

        stage('Smoke Test') {
            steps {
                sleep(time: 30, unit: 'SECONDS')
                smokeTest(
                    url:         env.APP_URL,
                    retries:     5,
                    waitSeconds: 15
                )
            }
        }
    }

    post {
        success {
            notifySlackSNS(
                status:      'SUCCESS',
                project:     env.PROJECT,
                buildNumber: params.BUILD_TAG.toInteger(),
                buildUrl:    env.BUILD_URL,
                region:      env.AWS_REGION
            )
        }
        failure {
            rollback(
                gitOpsRepo: env.GITOPS_REPO,
                project:    env.PROJECT
            )
            notifySlackSNS(
                status:      'FAILURE',
                project:     env.PROJECT,
                buildNumber: params.BUILD_TAG.toInteger(),
                buildUrl:    env.BUILD_URL,
                region:      env.AWS_REGION,
                stageName:   'Smoke Test + Rollback triggered'
            )
        }
        always {
            cleanWs()
        }
    }
}
